rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read for product images, category icons, and banners
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // User avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}